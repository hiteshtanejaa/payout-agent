# Stripe — TEST MODE ONLY
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # printed by `stripe listen`
CARD_COUNTRY=GB

# LLM — one key for the email extractor (litellm) and Cognee. Option A: OpenAI
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.6-luna
LLM_API_KEY=sk-...
OPENAI_API_KEY=sk-...                  # only for `agent.py chat` (OpenAI Agents SDK)

# Option B: Anthropic + local embeddings
# LLM_PROVIDER=anthropic
# LLM_MODEL=anthropic/claude-sonnet-5-5
# LLM_API_KEY=sk-ant-...
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384

# Memory
MEMORY_CHECK=cognee                    # cognee (fail closed: lookup error -> HOLD) | file (read notes/ directly)
COGNEE_SYNC=batch                      # batch (webhook stays fast) | live

# Cognee Cloud (optional)
COGNEE_SERVICE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=
