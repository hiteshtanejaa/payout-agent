# Stripe — TEST MODE ONLY
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # printed by `stripe listen`
# Heroku: use the hosted endpoint's signing secret, rather than the CLI's secret.
# STRIPE_ISSUING_WEBHOOK_SECRET=whsec_...  # only for a separate Issuing endpoint
# STRIPE_CARD_ID=ic_...                  # hosted card id; local file fallback still works
CARD_COUNTRY=GB

# LLM — one key for the email extractor (litellm) and Cognee. Option A: OpenAI
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.6-luna
LLM_API_KEY=sk-...
OPENAI_API_KEY=sk-...                  # only for `agent.py chat` (OpenAI Agents SDK)

# Option B: Anthropic + local embeddings
# LLM_PROVIDER=anthropic
# LLM_MODEL=anthropic/claude-sonnet-5-5
# LLM_API_KEY=sk-ant-...
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384

# Memory
MEMORY_CHECK=cognee                    # cognee (fail closed: lookup error -> HOLD) | file (read notes/ directly)
COGNEE_DATASET=treasurer               # decisions dataset; switch to a fresh name for a clean demo memory
COGNEE_SYNC=batch                      # batch (webhook stays fast) | live

# Cognee Cloud (optional)
COGNEE_SERVICE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=

# Hosted demo (Heroku sets DATABASE_URL when PostgreSQL is attached)
# DATABASE_URL=postgresql://...
# DEMO_USERNAME=demo
# DEMO_PASSWORD=choose-a-private-demo-password
