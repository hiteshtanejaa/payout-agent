# LLM (used by Cognee + invoice extractor) — Option A: OpenAI
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.6-luna
LLM_API_KEY=sk-...

# Option B: Anthropic + local embeddings
# LLM_PROVIDER=anthropic
# LLM_MODEL=anthropic/claude-sonnet-5-5
# LLM_API_KEY=sk-ant-...
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384

# Stripe — TEST MODE ONLY
STRIPE_SECRET_KEY=sk_test_...

# Cognee Cloud (from the console's API Keys page). If set, the agent's memory runs in your cloud tenant.
COGNEE_SERVICE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=
